# Copy to .env. Never use VITE_ for secrets. Do not commit .env.
# Ollama and Whisper run on this PC.
AI_ENABLED=false
FEATURE_OWNER_LOG_ENABLED=false
FEATURE_BRIEF_ENABLED=false
FEATURE_SHELTER_ENABLED=false
# Optional JSON file containing the real lesson catalog. Empty = no lesson suggestions.
LESSON_CATALOG_PATH=
AI_DAILY_LIMIT=200
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_CONTEXT_SIZE=8192
OLLAMA_TIMEOUT_MS=120000
WHISPER_EXECUTABLE=.local-ai/whisper/whisper-cli.exe
WHISPER_MODEL_PATH=.local-ai/models/ggml-medium-q5_0.bin
LOCAL_STT_TIMEOUT_MS=180000
FFMPEG_PATH=ffmpeg
# Optional absolute ffprobe executable path; defaults to ffprobe from PATH.
FFPROBE_PATH=ffprobe

# Local development
HOST=127.0.0.1
PORT=3001
PUBLIC_ORIGIN=http://127.0.0.1:5173
APP_ACCESS_PASSWORD=
TRUST_PROXY=0

# Public deployment: NODE_ENV=production, PUBLIC_ORIGIN=https://your-domain
# APP_ACCESS_PASSWORD must be at least 16 characters.
# Set HOST=0.0.0.0 in a container. TRUST_PROXY=1 only behind one trusted proxy.
