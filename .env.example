# Copy to .env. Never use VITE_ for secrets. Do not commit .env.
OPENAI_API_KEY=
AI_ENABLED=false
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TIMEOUT_MS=15000
AI_DAILY_LIMIT=200
# Optional absolute ffprobe executable path; defaults to ffprobe from PATH.
FFPROBE_PATH=ffprobe

# Local development
HOST=127.0.0.1
PORT=3001
PUBLIC_ORIGIN=http://127.0.0.1:5173
APP_ACCESS_PASSWORD=
TRUST_PROXY=0

# Public deployment: NODE_ENV=production, PUBLIC_ORIGIN=https://your-domain
# APP_ACCESS_PASSWORD must be at least 16 characters.
# Set HOST=0.0.0.0 in a container. TRUST_PROXY=1 only behind one trusted proxy.
