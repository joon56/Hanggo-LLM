{
  "name": "hanggo-session-notes",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "build": "npm run typecheck && vite build",
    "preview": "npm start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "llm:eval": "node --env-file-if-exists=.env scripts/eval.ts",
    "verify": "npm run test && npm run build && npm run test:e2e && npm run llm:eval"
  },
  "engines": { "node": ">=24.0.0 <25" },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "openai": "^7.25.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "supertest": "^7.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
